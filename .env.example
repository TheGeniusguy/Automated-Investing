# Copy to .env and fill in real values.
# Backend reads these via pydantic-settings.

# FRED API key — register at https://fredaccount.stlouisfed.org/apikeys (free, instant)
FRED_API_KEY=

# Anthropic API key — get at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model for briefings
CLAUDE_MODEL=claude-sonnet-4-6

# Unusual Whales API key — optional. Powers the Market News and Market Insiders
# feeds. Without it those panels degrade gracefully (empty data, needs-config state).
UNUSUAL_WHALES_API_KEY=

# Backend settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS — frontend dev origin
FRONTEND_ORIGIN=http://localhost:5173

# SEC EDGAR requires a User-Agent identifying who you are. They block requests
# that don't supply one. Default below works; replace with your name + email
# for politeness. https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=Automated-Investing daniel@solutions-imagined.com
